# ============================================================
# SERVER ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================

# MongoDB Atlas Connection URI (Cluster: akilesh-portfolio, DB: portfolio_db)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/portfolio_db?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/portfolio_db?retryWrites=true&w=majority

# Server Port
PORT=5000

# Client Application URL (For CORS)
CLIENT_URL=http://localhost:5173

# Node Environment
NODE_ENV=development

# Optional Email Notification Service (e.g., SMTP / Nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFICATION_EMAIL=akileshanand302006@gmail.com
