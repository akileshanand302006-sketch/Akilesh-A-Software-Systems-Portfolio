# ============================================================
# SERVER ENVIRONMENT CONFIGURATION
# ============================================================

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.owyzur7.mongodb.net/portfolio_db?retryWrites=true&w=majority

# ============================================================
# OPTION 1: Resend (Recommended for Modern Hosting)
# Sign up at https://resend.com to obtain an API key
# ============================================================
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=Portfolio Contact <onboarding@resend.dev>

# ============================================================
# OPTION 2: SMTP / Nodemailer (Gmail, Brevo, SendGrid, SES)
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password

# The email address that receives visitor messages
PORTFOLIO_EMAIL=akileshanand302006@gmail.com
